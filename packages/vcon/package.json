{
  "name": "@verifymymeeting/vcon",
  "version": "0.1.0",
  "description": "IETF vCon (draft-ietf-vcon-vcon-core-05, syntax 0.5.0) types, builder, validator, content hashes, JWS signing, and the VerifyMyMeeting extension and mapping",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@verifymymeeting/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "@types/node": "^22.10.2"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/verify-my-meeting/verify-sdk.git",
    "directory": "packages/vcon"
  }
}
