{
  "name": "verify-sdk",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm --filter @verifymymeeting/sdk build && pnpm -r typecheck",
    "test": "pnpm --filter @verifymymeeting/sdk build && pnpm -r test",
