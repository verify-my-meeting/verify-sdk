    "build": "pnpm -r build",
    "format": "prettier --write .",
    "check": "prettier --check ."
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "@types/node": "^22.10.2"
  }
}
